{
  "ciTool": "github",
  "appName": "pipeline-test",
  "orgId": "79cbd9ec-258c-42de-8e23-24259754f632",
  "controlPlane": "us",
  "muleRuntime": "4.12.0",
  "javaVersion": "17",
  "mainBranch": "main",
  "runMunit": true,
  "versionStrategy": "build-number",
  "envPropertyName": "env",
  "usesSecureProperties": false,
  "secureKeyPropertyName": "secure.key",
  "needsEeRepo": false,
  "defaultTarget": "Cloudhub-US-East-2",
  "jenkins": {
    "mavenTool": "maven-3",
    "jdkTool": "jdk-17"
  },
  "updatePom": true,
  "environments": [
    {
      "key": "dev",
      "anypointEnvironment": "Development",
      "applicationName": "pipeline-test-dev",
      "target": "Cloudhub-US-East-2",
      "replicas": 1,
      "vCores": "0.1",
      "approval": false,
      "muleEnvValue": "dev"
    },
    {
      "key": "qa",
      "anypointEnvironment": "QA",
      "applicationName": "pipeline-test-qa",
      "target": "Cloudhub-US-East-2",
      "replicas": 1,
      "vCores": "0.1",
      "approval": false,
      "muleEnvValue": "qa"
    },
    {
      "key": "uat",
      "anypointEnvironment": "UAT",
      "applicationName": "pipeline-test-uat",
      "target": "Cloudhub-US-East-2",
      "replicas": 1,
      "vCores": "0.1",
      "approval": true,
      "muleEnvValue": "uat"
    },
    {
      "key": "prod",
      "anypointEnvironment": "Production",
      "applicationName": "pipeline-test-prod",
      "target": "Cloudhub-US-East-2",
      "replicas": 2,
      "vCores": "0.1",
      "approval": true,
      "muleEnvValue": "prod"
    }
  ],
  "kitVersion": "1.0.0"
}
